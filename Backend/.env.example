# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Nunca subas el archivo .env real al repositorio.

# SQL Server
DB_USER=usuario_sql_server
DB_PASSWORD=contrasena_sql_server
DB_SERVER=localhost
DB_DATABASE=DB_Veterinaria
DB_PORT=1433

# Backend
PORT=4000
JWT_SECRET=reemplaza_por_una_clave_larga_y_secreta

# Correo utilizado para las notificaciones de Vet-Care
EMAIL_USER=correo@gmail.com
EMAIL_PASSWORD=contrasena_de_aplicacion_de_google
